<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover">
    <meta name="mobile-web-app-capable" content="yes">
    <meta name="apple-mobile-web-app-capable" content="yes">
    <title>PPTX Snap & Batch</title>
    
    <!-- PWA Manifest -->
    <link rel="manifest" href="data:application/manifest+json,{'name':'PPTX Batcher','short_name':'PPTX','start_url':'.','display':'standalone','background_color':'#000000','theme_color':'#2c3e50'}">
    
    <!-- Libraries -->
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/cropperjs/1.5.13/cropper.min.css">
    <script src="https://cdnjs.cloudflare.com/ajax/libs/cropperjs/1.5.13/cropper.min.js"></script>
    <script src="https://cdn.jsdelivr.net/gh/gitbrent/pptxgenjs@3.12.0/dist/pptxgen.bundle.js"></script>

    <style>
        :root {
            --bg: #f8f9fa;
            --primary: #2c3e50;
            --accent: #3498db;
        }
        body { 
            font-family: -apple-system, sans-serif; 
            margin: 0; background: var(--bg); 
            height: 100vh; overflow: hidden; 
            display: flex; flex-direction: column;
        }

        /* Camera View Styles */
        #view-camera { flex: 1; background: #000; position: relative; display: flex; flex-direction: column; }
        #video { width: 100%; height: 100%; object-fit: cover; }
        
        .cam-controls { 
            position: absolute; bottom: 40px; width: 100%; 
            display: flex; justify-content: space-around; align-items: center; 
        }

        /* Crop View Styles */
        #view-crop { display: none; flex: 1; flex-direction: column; background: #000; }
        .crop-container { flex: 1; overflow: hidden; position: relative; }
        .crop-footer { background: #fff; padding: 20px; display: flex; gap: 10px; }

        /* Gallery/Batch View Styles */
        #view-batch { display: none; flex: 1; overflow-y: auto; padding: 15px; }
        .batch-grid { display: grid; grid-template-columns: 1fr 1fr; gap: 10px; }
        .batch-item { background: #fff; border-radius: 8px; overflow: hidden; box-shadow: 0 2px 5px rgba(0,0,0,0.1); position: relative; }
        .batch-item img { width: 100%; aspect-ratio: 4/3; object-fit: cover; }

        /* UI Elements */
        .btn-snap { width: 70px; height: 70px; border-radius: 50%; border: 5px solid #fff; background: transparent; position: relative; }
        .btn-snap::after { content: ''; position: absolute; inset: 5px; background: #fff; border-radius: 50%; }
        .btn-circle { width: 50px; height: 50px; border-radius: 50%; border: none; background: rgba(255,255,255,0.2); color: #fff; font-size: 20px; }
        
        .btn-action { flex: 1; padding: 15px; border-radius: 8px; border: none; font-weight: bold; font-size: 16px; cursor: pointer; }
        .btn-primary { background: var(--accent); color: white; }
        .btn-secondary { background: #ddd; color: #333; }

        nav { height: 70px; background: #fff; border-top: 1px solid #ddd; display: flex; padding-bottom: env(safe-area-inset-bottom); }
        nav button { flex: 1; border: none; background: none; font-weight: bold; color: #7f8c8d; }
        nav button.active { color: var(--accent); }

        .counter { position: absolute; top: 10px; right: 10px; background: var(--accent); color: white; padding: 5px 12px; border-radius: 15px; font-size: 12px; }
    </style>
</head>
<body>

    <!-- Camera Screen -->
    <div id="view-camera">
        <video id="video" autoplay playsinline muted></video>
        <div class="cam-controls">
            <button class="btn-circle" onclick="showView('batch')">🖼️</button>
            <button class="btn-snap" onclick="capturePhoto()"></button>
            <button class="btn-circle" id="btn-flip" onclick="flipCamera()">🔄</button>
        </div>
    </div>

    <!-- Crop Screen -->
    <div id="view-crop">
        <div class="crop-container">
            <img id="crop-target">
        </div>
        <div class="crop-footer">
            <button class="btn-action btn-secondary" onclick="cancelCrop()">Discard</button>
            <button class="btn-action btn-primary" onclick="saveCrop()">Add to Batch</button>
        </div>
    </div>

    <!-- Gallery Screen -->
    <div id="view-batch">
        <h2 style="margin-top:0">Your Batch</h2>
        <div id="batch-empty" style="text-align: center; padding: 40px; color: #888;">No photos captured yet.</div>
        <div class="batch-grid" id="batch-grid"></div>
        
        <div style="margin-top: 30px;">
            <button class="btn-action btn-primary" style="width: 100%;" onclick="exportToPPTX()">Export to PowerPoint</button>
            <button class="btn-action btn-secondary" style="width: 100%; margin-top: 10px; color: #c0392b;" onclick="clearBatch()">Clear All</button>
        </div>
    </div>

    <nav>
        <button id="nav-camera" class="active" onclick="showView('camera')">CAMERA</button>
        <button id="nav-batch" onclick="showView('batch')">BATCH (<span id="batch-count">0</span>)</button>
    </nav>

<script>
    let state = {
        photos: [],
        facingMode: 'environment',
        stream: null,
        cropper: null
    };

    // --- CAMERA LOGIC (ADOPTED FROM SNAPDECK) ---
    async function startCamera() {
        // Stop any existing tracks
        if (state.stream) {
            state.stream.getTracks().forEach(track => track.stop());
            state.stream = null;
        }

        try {
            const constraints = {
                video: {
                    facingMode: { ideal: state.facingMode },
                    width: { ideal: 1920 },
                    height: { ideal: 1080 }
                },
                audio: false
            };
            state.stream = await navigator.mediaDevices.getUserMedia(constraints);
            const videoEl = document.getElementById('video');
            videoEl.srcObject = state.stream;
            await videoEl.play();
        } catch (err) {
            alert("Camera Error: " + err.message);
        }
    }

    function flipCamera() {
        state.facingMode = state.facingMode === 'environment' ? 'user' : 'environment';
        startCamera();
    }

    // --- CAPTURE & CROP LOGIC ---
    function capturePhoto() {
        const videoEl = document.getElementById('video');
        const canvas = document.createElement('canvas');
        canvas.width = videoEl.videoWidth;
        canvas.height = videoEl.videoHeight;
        const ctx = canvas.getContext('2d');
        ctx.drawImage(videoEl, 0, 0);
        
        const dataUrl = canvas.toDataURL('image/jpeg', 0.9);
        initCropScreen(dataUrl);
    }

    function initCropScreen(src) {
        document.getElementById('view-camera').style.display = 'none';
        document.getElementById('view-crop').style.display = 'flex';
        
        const image = document.getElementById('crop-target');
        image.src = src;

        if (state.cropper) state.cropper.destroy();
        
        image.onload = () => {
            state.cropper = new Cropper(image, {
                viewMode: 1,
                autoCropArea: 0.8,
                checkOrientation: false
            });
        };
    }

    function cancelCrop() {
        showView('camera');
    }

    function saveCrop() {
        const croppedCanvas = state.cropper.getCroppedCanvas({ maxWidth: 1600 });
        const croppedData = croppedCanvas.toDataURL('image/jpeg', 0.85);
        state.photos.push(croppedData);
        updateUI();
        showView('camera');
    }

    // --- NAVIGATION & UI ---
    function showView(viewName) {
        // Reset displays
        document.getElementById('view-camera').style.display = 'none';
        document.getElementById('view-crop').style.display = 'none';
        document.getElementById('view-batch').style.display = 'none';
        document.getElementById('nav-camera').classList.remove('active');
        document.getElementById('nav-batch').classList.remove('active');

        // Show active
        document.getElementById('view-' + viewName).style.display = (viewName === 'camera') ? 'flex' : 'block';
        document.getElementById('nav-' + viewName).classList.add('active');

        if (viewName === 'camera') startCamera();
        if (viewName === 'batch') renderBatch();
    }

    function updateUI() {
        document.getElementById('batch-count').innerText = state.photos.length;
    }

    function renderBatch() {
        const grid = document.getElementById('batch-grid');
        const emptyMsg = document.getElementById('batch-empty');
        grid.innerHTML = '';
        
        if (state.photos.length === 0) {
            emptyMsg.style.display = 'block';
            return;
        }
        
        emptyMsg.style.display = 'none';
        state.photos.forEach((img, idx) => {
            const div = document.createElement('div');
            div.className = 'batch-item';
            div.innerHTML = `<img src="${img}"><div style="padding:5px; font-size:10px; text-align:center">Slide ${idx+1}</div>`;
            grid.appendChild(div);
        });
    }

    function clearBatch() {
        if (confirm("Delete all captured slides?")) {
            state.photos = [];
            updateUI();
            renderBatch();
        }
    }

    // --- EXPORT ---
    async function exportToPPTX() {
        if (state.photos.length === 0) return alert("No photos to export.");

        const pptx = new PptxGenJS();
        pptx.layout = 'LAYOUT_WIDE';

        state.photos.forEach((imgData, index) => {
            let slide = pptx.addSlide();
            slide.background = { color: "000000" };
            slide.addImage({ 
                data: imgData, 
                x: 0, y: 0, w: '100%', h: '100%',
                sizing: { type: 'contain', w: 10, h: 5.6 } 
            });
        });

        pptx.writeFile({ fileName: `SnapBatch_${Date.now()}.pptx` });
    }

    // --- PWA SERVICE WORKER ---
    if ('serviceWorker' in navigator) {
        const sw = `self.addEventListener('fetch', function(e) { e.respondWith(fetch(e.request)); });`;
        const blob = new Blob([sw], {type: 'text/javascript'});
        navigator.serviceWorker.register(URL.createObjectURL(blob));
    }

    // Initialize
    window.onload = startCamera;
</script>
</body>
</html>
